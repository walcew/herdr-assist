# fix for build issue
CONFIG_FREERTOS_HZ=1000
# anti-brick do OTA: app novo boota como PENDING_VERIFY e precisa se confirmar
# (fw_update_init); se crashar antes, o bootloader volta sozinho ao slot anterior
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# TLS na PSRAM: o handshake do OTA (buffer de 16KB + contexto + cert bundle)
# não cabia mais na heap interna com a UI e as pontes de pé — mbedtls_ssl_setup
# voltava -0x7F00 (ALLOC_FAILED) e a checagem morria antes do manifest.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Nomes longos no cartão SD: o padrão do IDF é 8.3 puro (FATFS_LFN_NONE), em
# que "spiderman.hav" não cabe. Os pacotes de avatar são nomeados pelo id, que
# vem de repositório de terceiro — 8 caracteres não é contrato defensável.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# RAM interna reservada para quem não pode usar PSRAM (descritor DMA, buffer do
# Wi-Fi, stack de task). O port do vendor veio com 0 — com zero reservado, um
# malloc comum consome a última página interna e a próxima alocação que EXIGE
# interna morre em assert, reiniciando o painel. 32768 é o padrão do IDF.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
